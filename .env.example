DATABASE_URL="postgresql://postgres@localhost:5432/dd2_dev"

# --- Trackmania OAuth (web admin login) ---
# Register at: https://api.trackmania.com/ (create application)
# Docs: https://webservices.openplanet.dev/oauth/auth
# Checklist:
#   1. Create app → set Confidential = yes (immutable after create)
#   2. Redirect URI must exactly match TM_OAUTH_REDIRECT_URI below
#      Prod example: https://dips-plus-plus-server.xk.io/api/mod/oauth/callback
#      Local example: http://localhost:8077/api/mod/oauth/callback
#   3. Copy Identifier → TM_OAUTH_CLIENT_ID
#   4. Copy Secret → TM_OAUTH_CLIENT_SECRET
TM_OAUTH_CLIENT_ID=""
TM_OAUTH_CLIENT_SECRET=""
TM_OAUTH_REDIRECT_URI=""

# --- Nadeo Live (lazy Map Author lookup) ---
# Create dedicated-server login at: https://www.trackmania.com/player/dedicated-servers
# Docs: https://webservices.openplanet.dev/auth/dedi
# Checklist:
#   1. Create a server login (password shown once — save it)
#   2. Put login → DD2_NADEO_DS_USERNAME
#   3. Put password → DD2_NADEO_DS_PASSWORD
#   4. Set a contact email for the required Nadeo User-Agent
DD2_NADEO_DS_USERNAME=""
DD2_NADEO_DS_PASSWORD=""
DD2_NADEO_UA_EMAIL=""
